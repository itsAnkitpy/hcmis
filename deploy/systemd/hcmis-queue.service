# HCIMS — the recording worker.
# Without this, calls work perfectly and recordings silently never appear,
# minutes after the call already ended. Caught us twice in the lab.
[Unit]
Description=HCIMS queue worker (call recordings)
After=network.target postgresql.service

[Service]
Type=simple
User=hcmis
Group=hcmis
WorkingDirectory=/home/hcmis/public_html
# --max-time makes the worker retire itself hourly; systemd starts a fresh one.
# Keeps memory flat and means a deploy is picked up without anyone remembering to restart it.
ExecStart=/usr/bin/php8.4 artisan queue:work --sleep=3 --tries=3 --max-time=3600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
